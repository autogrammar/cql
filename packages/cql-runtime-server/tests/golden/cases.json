[
  {
    "id": "quote-hello",
    "endpoint": "quote",
    "body": { "value": "hello" },
    "expect": { "quoted": "'hello'" }
  },
  {
    "id": "quote-apostrophe",
    "endpoint": "quote",
    "body": { "value": "O'Neill" },
    "expect": { "quoted": "\"O'Neill\"" }
  },
  {
    "id": "normalize-single-to-double",
    "endpoint": "normalize",
    "body": { "text": "SET 'x' '5'" },
    "expect": { "text": "SET \"x\" \"5\"" }
  },
  {
    "id": "exec-simple-set",
    "endpoint": "exec",
    "body": {
      "text": "VERSION: 6\nSCENARIO: Test\nTASK:\n  NAME \"Test Goal\"\n  SET \"x\" \"5\"\n"
    },
    "expect": {
      "ok": true,
      "planKinds": ["goal", "var"]
    }
  },
  {
    "id": "exec-condition",
    "endpoint": "exec",
    "body": {
      "text": "VERSION: 6\nSCENARIO: Condition Test\nTASK:\n  NAME 'Prepare'\n  SET 'x' '5'\nTEST_STEP:\n  NAME 'Check'\n  VAL 'x'\n  IF 'x' >= '3'\n  PASS 'x' 'Passed'\n  FAIL 'x' 'Failed'\n"
    },
    "expect": {
      "ok": true,
      "planKindsIncludes": ["condition"]
    }
  },
  {
    "id": "exec-log",
    "endpoint": "exec",
    "body": {
      "text": "VERSION: 6\nSCENARIO: Log Test\nTASK:\n  NAME \"Log\"\n  LOG \"test message\"\n"
    },
    "expect": {
      "ok": true,
      "planKindsIncludes": ["message"]
    }
  },
  {
    "id": "reject-unmigrated-motor2-left",
    "endpoint": "exec",
    "body": {
      "text": "SCENARIO: Motor\nGOAL: Move\n  motor2 left 1000\n"
    },
    "expect": {
      "ok": false
    }
  },
  {
    "id": "reject-unmigrated-motor2-sequence",
    "endpoint": "exec",
    "body": {
      "text": "SCENARIO: Motor\nGOAL: Move\n  motor2 left 1000\n  wait 1s\n  motor2 right 100\n"
    },
    "expect": {
      "ok": false
    }
  },
  {
    "id": "parse-minimal",
    "endpoint": "parse",
    "body": {
      "text": "VERSION: 6\nSCENARIO: Smoke\nTASK:\n  NAME 'G1'\n  SET 'a' '1'\n"
    },
    "expect": {
      "ok": true,
      "scenario": "Smoke"
    }
  },
  {
    "id": "validate-v6-minimal",
    "endpoint": "validate",
    "body": { "text": "VERSION: 6\nSCENARIO: X\nTASK:\n  NAME 'Y'\n" },
    "expect": {
      "ok": true
    }
  }
]
