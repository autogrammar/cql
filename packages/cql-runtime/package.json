{
  "name": "@oqlos/cql-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OQL v6 runtime facade via @semcod/oqlts with isolated legacy DSL compatibility modules",
  "dependencies": {
    "@semcod/oqlts": "file:../../vendor/oqlts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./oqlts": "@semcod/oqlts",
    "./quotes": "./src/compat/quotes.ts",
    "./parser": "./src/compat/parser.ts",
    "./exec": "./src/compat/exec.ts",
    "./mapping": "./src/compat/mapping.ts",
    "./validator": "./src/compat/validator.ts",
    "./highlight": "./src/compat/highlight.ts",
    "./serialize": "./src/compat/serialize.ts",
    "./scenario-builders": "./src/compat/scenario-builders.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. runtime/dsl.exec.test.ts runtime/dsl.mapping.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
